<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MultiAI" android:textSize="30sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Gemini • Groq • OpenRouter • more" android:textSize="16sp"/>
    <Spinner android:id="@+id/providerSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"/>
    <EditText android:id="@+id/model" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Model (optional)" android:singleLine="true"/>
    <EditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="API key" android:inputType="textPassword" android:singleLine="true"/>
    <Button android:id="@+id/saveKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Save key securely"/>
    <CheckBox android:id="@+id/autoMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto fallback across configured providers"/>
    <EditText android:id="@+id/prompt" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp" android:gravity="top" android:hint="Ask anything..." android:inputType="textMultiLine"/>
    <Button android:id="@+id/sendButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Send"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ready" android:textSize="14sp"/>
    <TextView android:id="@+id/response" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Response will appear here." android:textSize="16sp"/>
</LinearLayout>
</ScrollView>
